local function nestedHandler(item)
	game:GetService("VirtualInputManager"):SendKeyEvent(true, item, false, game)
	game:GetService("VirtualInputManager"):SendKeyEvent(false, item, false, game)
end
local function innerHandler()
	local InteriorLava = game.Workspace.Map.PrehistoricIsland.Core:FindFirstChild("InteriorLava")

	if InteriorLava and InteriorLava:IsA("Model") then
		InteriorLava:Destroy()
	end

	local PrehistoricIsland = game.Workspace.Map:FindFirstChild("PrehistoricIsland")

	if PrehistoricIsland then
		for _, descendant in pairs(PrehistoricIsland:GetDescendants()) do
			if descendant:IsA("Part") and descendant.Name:lower():find("lava") then
				descendant:Destroy()
			end
		end
	end

	local prehistoricIsland = game.Workspace.Map:FindFirstChild("PrehistoricIsland")

	if prehistoricIsland then
		for _, descendant in pairs(prehistoricIsland:GetDescendants()) do
			if descendant:IsA("Model") then
				for _, item in pairs(descendant:GetDescendants()) do
					if item:IsA("MeshPart") and item.Name:lower():find("lava") then
						item:Destroy()
					end
				end
			end
		end
	end
end
local function handleInput()
	local VolcanoRocks = game.Workspace.Map.PrehistoricIsland.Core.VolcanoRocks

	for _, child in pairs(VolcanoRocks:GetChildren()) do
		if child:IsA("Model") then
			local volcanorock = child:FindFirstChild("volcanorock")

			if volcanorock and volcanorock:IsA("MeshPart") then
				local volcanorockColor = volcanorock.Color

				if volcanorockColor == Color3.fromRGB(185, 53, 56) or volcanorockColor == Color3.fromRGB(185, 53, 57) then
					return volcanorock
				end
			end
		end
	end

	return nil
end
local function outerHandler(argument)
	local localValuePlayer = game.Players.LocalPlayer
	local Backpack = localValuePlayer.Backpack

	for _, child in pairs(Backpack:GetChildren()) do
		if child:IsA("Tool") and argument == child.ToolTip then
			child.Parent = localValuePlayer.Character

			for _, item in ipairs({
				"Z",
				"X",
				"C",
				"V",
				"F"
			}) do
				wait()
				pcall(function()
					nestedHandler(item)
				end)
			end

			child.Parent = Backpack

			return
		end
	end
end

spawn(function()
	while wait() do
		if _G.AutoDefendVolcano then
			AutoHaki()
			pcall(innerHandler)

			local input = handleInput()

			if not input then
				_G.TweenToPrehistoric = true
			else
				local secondaryCFrame = CFrame.new(input.Position + Vector3.new(0, 0, 0))

				Tween2(secondaryCFrame)

				local Color = input.Color

				if Color == Color3.fromRGB(185, 53, 56) or Color == Color3.fromRGB(185, 53, 57) then
					if (game.Players.LocalPlayer.Character.HumanoidRootPart.Position - input.Position - Vector3.new(0, 0, 0)).Magnitude <= 1 then
						if _G.UseMelee then
							outerHandler("Melee")
						end

						if _G.UseSword then
							outerHandler("Sword")
						end

						if _G.UseGun then
							outerHandler("Gun")
						end
					end

					_G.TweenToPrehistoric = false
				else
					handleInput()
				end
			end
		end
	end
end)
