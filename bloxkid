function AttackNoCoolDown()
	local Character = LocalPlayer.Character

	if Character then
		local capturedChild = nil

		for _, child in ipairs(Character:GetChildren()) do
			if child:IsA("Tool") then
				capturedChild = child

				break
			end
		end

		if capturedChild then
			local function isValid(humanoidContainer)
				return humanoidContainer and (humanoidContainer:FindFirstChild("Humanoid") and humanoidContainer.Humanoid.Health > 0)
			end

			if not capturedChild:FindFirstChild("LeftClickRemote") then
				local fireserverConfig = {}
				local children = game:GetService("Workspace").Enemies:GetChildren()
				local Position = Character:GetPivot().Position
				local capturedHead = nil

				for _, headContainer in ipairs(children) do
					if not headContainer:GetAttribute("IsBoat") and isValid(headContainer) then
						local Head = headContainer:FindFirstChild("Head")

						if Head and (Position - Head.Position).Magnitude <= 60 then
							table.insert(fireserverConfig, {
								headContainer,
								Head
							})
							capturedHead = Head
						end
					end
				end

				if not capturedHead then
					return
				end

				pcall(function()
					local ReplicatedStorage = game:GetService("ReplicatedStorage")
					local reRegisterAttack = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterAttack")
					local reRegisterHit = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Net"):WaitForChild("RE/RegisterHit")

					if not (#fireserverConfig > 0) then
						task.wait(1E-09)
					else
						reRegisterAttack:FireServer(1E-09)
						reRegisterHit:FireServer(capturedHead, fireserverConfig)
					end
				end)
			else
				local sum = 1
				local data = (function(argument)
					local children = game:GetService("Workspace").Enemies:GetChildren()
					local humanoidRootPartContainers = {}
					local Position = Character:GetPivot().Position

					for _, humanoidRootPartContainer in ipairs(children) do
						local HumanoidRootPart = humanoidRootPartContainer:FindFirstChild("HumanoidRootPart")

						if HumanoidRootPart and isValid(humanoidRootPartContainer) and argument >= (HumanoidRootPart.Position - Position).Magnitude then
							table.insert(humanoidRootPartContainers, humanoidRootPartContainer)
						end
					end

					return humanoidRootPartContainers
				end)(60)

				for _, item in ipairs(data) do
					local Unit = (item.HumanoidRootPart.Position - Character:GetPivot().Position).Unit

					pcall(function()
						capturedChild.LeftClickRemote:FireServer(Unit, sum)
					end)
					sum = sum + 1

					if sum > 1000000000 then
						sum = 1
					end
				end
			end

			return
		end

		return
	end
end

