function Tween2(input)
	local Magnitude = (input.Position - game.Players.LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
	local tweenInfoNumber = 350
	local tweenInfo = TweenInfo.new(Magnitude / tweenInfoNumber, Enum.EasingStyle.Linear)
	local create = game:GetService("TweenService"):Create(game.Players.LocalPlayer.Character.HumanoidRootPart, tweenInfo, {
		CFrame = input
	})

	create:Play()

	if _G.StopTween2 then
		create:Cancel()
	end

	_G.Clip2 = true
	wait(Magnitude / tweenInfoNumber)
	_G.Clip2 = false
end
