function Hop()
	local placeId = game.PlaceId
	local hours = {}
	local addSectionText = ""
	local hour = os.date("!*t").hour

	function TPReturner()
		local data

		if addSectionText ~= "" then
			data = game.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100&cursor=" .. addSectionText))
		else
			data = game.HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Asc&limit=100"))
		end

		local text = ""

		if data.nextPageCursor and data.nextPageCursor ~= "null" and data.nextPageCursor ~= nil then
			addSectionText = data.nextPageCursor
		end

		local sum = 0

		for _, item in pairs(data.data) do
			local flag = true

			text = tostring(item.id)

			if tonumber(item.maxPlayers) > tonumber(item.playing) then
				for _, item in pairs(hours) do
					if sum == 0 then
						if tonumber(hour) ~= tonumber(item) then
							pcall(function()
								hours = {}
								table.insert(hours, hour)
							end)
						end
					elseif text == tostring(item) then
						flag = false
					end

					sum = sum + 1
				end

				if flag == true then
					table.insert(hours, text)
					wait()
					pcall(function()
						wait()
						game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, text, game.Players.LocalPlayer)
					end)
					wait()
				end
			end
		end
	end
	function addSection()
		while wait() do
			pcall(function()
				TPReturner()

				if addSectionText ~= "" then
					TPReturner()
				end
			end)
		end
	end

	addSection()
end

